    {
      "type": "table",
      "title": "Running sandboxes",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "kiln-prometheus"
      },
      "description": "One row per running sandbox, current values. Short runs come and go between 5 s scrapes, so the totals above are the reliable counts.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kiln-prometheus"
          },
          "expr": "max by (run) (time() - kiln_sandbox_start_time_seconds)",
          "legendFormat": "",
          "refId": "Age",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kiln-prometheus"
          },
          "expr": "max by (run) (kiln_sandbox_memory_bytes)",
          "legendFormat": "",
          "refId": "Memory",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kiln-prometheus"
          },
          "expr": "max by (run) (kiln_sandbox_memory_limit_bytes)",
          "legendFormat": "",
          "refId": "Memory limit",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kiln-prometheus"
          },
          "expr": "sum by (run) (rate(kiln_sandbox_cpu_seconds_total[$__rate_interval]))",
          "legendFormat": "",
          "refId": "CPU cores",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kiln-prometheus"
          },
          "expr": "max by (run) (kiln_sandbox_cpu_limit_cores)",
          "legendFormat": "",
          "refId": "CPU limit",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kiln-prometheus"
          },
          "expr": "max by (run) (kiln_sandbox_pids)",
          "legendFormat": "",
          "refId": "PIDs",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kiln-prometheus"
          },
          "expr": "max by (run) (kiln_sandbox_disk_used_bytes)",
          "legendFormat": "",
          "refId": "Disk",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kiln-prometheus"
          },
          "expr": "max by (run) (kiln_sandbox_oom_kills_total)",
          "legendFormat": "",
          "refId": "OOM kills",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kiln-prometheus"
          },
          "expr": "max by (run) (kiln_sandbox_egress_rejected_packets_total)",
          "legendFormat": "",
          "refId": "Rejected packets",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "run": 0
            },
            "renameByName": {
              "Value #Age": "Age",
              "Value #Memory": "Memory",
              "Value #Memory limit": "Memory limit",
              "Value #CPU cores": "CPU (cores)",
              "Value #CPU limit": "CPU limit",
              "Value #PIDs": "PIDs",
              "Value #Disk": "Disk used",
              "Value #OOM kills": "OOM kills",
              "Value #Rejected packets": "Rejected packets"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Memory.*|Disk used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU (cores)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "OOM kills|Rejected packets"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
