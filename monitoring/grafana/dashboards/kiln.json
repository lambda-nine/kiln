{
  "title": "kiln",
  "uid": "kiln",
  "tags": [
    "kiln"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "description": "Sandbox resource use from kiln metrics, kiln dns and node_exporter.",
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Sandbox",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "kiln-prometheus"
        },
        "query": {
          "query": "label_values(kiln_sandbox_memory_bytes, run)",
          "refId": "run"
        },
        "definition": "label_values(kiln_sandbox_memory_bytes, run)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 2,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
