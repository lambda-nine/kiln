[Unit]
Description=kiln DNS forwarder for sandboxes (10.88.0.1:53)
After=network-online.target kiln-network-setup.service
Wants=network-online.target
Requires=kiln-network-setup.service

[Service]
User=kiln-dns
Group=kiln-dns
ExecStart=/usr/local/bin/kiln dns
Restart=on-failure
TasksMax=64
MemoryMax=128M
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/run/kiln/net/dns -/run/systemd/resolve
InaccessiblePaths=-/var/lib/kiln -/run/kiln/net/leases

[Install]
WantedBy=multi-user.target
